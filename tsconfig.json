    "**/*.tsx",
    ".next-lw/types/**/*.ts",
    ".next/types/**/*.ts",
    "/tmp/claude-501/-Users-symbol-Desktop-viridian-films-main/be24e422-ac40-41af-afda-8c0f8a76fa43/scratchpad/next-dist/types/**/*.ts",
    "/tmp/claude-501/-Users-symbol-Desktop-viridian-films-main/be24e422-ac40-41af-afda-8c0f8a76fa43/scratchpad/next-dist2/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-preview/types/**/*.ts"
